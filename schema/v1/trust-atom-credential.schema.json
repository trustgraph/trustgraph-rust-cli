{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustgraph.net/schemas/v1/trust-atom-credential.schema.json",
  "title": "Trust Atom credential (Trust Graph v1 profile of W3C VC 2.0)",
  "description": "A Trust Atom as a W3C Verifiable Credential 2.0, unsigned or signed with an eddsa-jcs-2022 Data Integrity proof. Schema validation is not verification: verifiers must also check the signature and that the verification method belongs to the issuer. See https://github.com/trustgraph/trustgraph-rust-cli/blob/master/doc/protocol.md",
  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject"],
  "dependentRequired": { "proof": ["validFrom"] },
  "additionalProperties": false,
  "properties": {
    "@context": {
      "const": ["https://www.w3.org/ns/credentials/v2", "https://trustgraph.net/ns/v1"]
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["VerifiableCredential", "TrustAtomCredential"] }
    },
    "issuer": {
      "description": "The atom's source. A did:key once signed.",
      "$ref": "trust-atom.schema.json#/$defs/uri"
    },
    "validFrom": {
      "description": "The atom's timestamp (an XML Schema dateTimeStamp). Required once signed.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The atom's target: an absolute URI.",
          "$ref": "trust-atom.schema.json#/$defs/uri"
        },
        "content": { "$ref": "trust-atom.schema.json#/$defs/content" },
        "value": { "$ref": "trust-atom.schema.json#/$defs/value" },
        "extra": { "$ref": "trust-atom.schema.json#/$defs/extra" },
        "replaces": { "$ref": "trust-atom.schema.json#/$defs/replaces" }
      }
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "credentialSchema": { "$ref": "#/$defs/references" },
    "relatedResource": { "$ref": "#/$defs/references" },
    "proof": {
      "description": "One eddsa-jcs-2022 proof, or a proof set containing exactly one (proofs from other suites are ignored).",
      "anyOf": [
        { "$ref": "#/$defs/proof" },
        {
          "type": "array",
          "items": { "type": "object" },
          "contains": { "$ref": "#/$defs/proof" },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "digestSRI": { "type": "string" },
        "digestMultibase": { "type": "string" },
        "mediaType": { "type": "string" }
      }
    },
    "references": {
      "anyOf": [
        { "$ref": "#/$defs/reference" },
        { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      ]
    },
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "verificationMethod", "proofPurpose", "proofValue"],
      "additionalProperties": false,
      "properties": {
        "@context": { "type": "array", "items": { "type": "string" } },
        "id": { "type": "string" },
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "const": "eddsa-jcs-2022" },
        "created": { "type": "string" },
        "expires": { "type": "string" },
        "verificationMethod": {
          "description": "A did:key Multikey: did:key:z6Mk…#z6Mk… (the same key twice).",
          "type": "string",
          "pattern": "^did:key:(z6Mk[1-9A-HJ-NP-Za-km-z]+)#\\1$"
        },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": {
          "description": "The Ed25519 signature, base58btc multibase.",
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        },
        "domain": { "type": "string" },
        "challenge": { "type": "string" },
        "nonce": { "type": "string" }
      }
    }
  }
}
